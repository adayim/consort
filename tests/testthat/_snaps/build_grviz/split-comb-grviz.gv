digraph consort_diagram {
  graph [layout = dot, splines=ortho]

node [shape = rectangle]





# node definitions with substituted label text

node1 [label = "Study 1 (n=8)" group=S1 fillcolor="white" style="filled" fontcolor="black"]
node2 [label = "Study 2 And this is long (n=12)" group=S2 fillcolor="white" style="filled" fontcolor="black"]
node3 [label = "Study 3 (n=12)" group=S3 fillcolor="white" style="filled" fontcolor="black"]
node4 [label = "Study 3 (n=12)" group=S4 fillcolor="white" style="filled" fontcolor="black"]
node5 [label = "Study 3 (n=12)" group=S5 fillcolor="white" style="filled" fontcolor="black"]
node6 [label = "Included All (n=20)" group=S3 fillcolor="white" style="filled" fontcolor="black"]
node7 [label = "Excluded (n=7):\l MRI not collected (n=3)\l" fillcolor="white" style="filled" fontcolor="black"]
node8 [label = "Randomised" group=S3 fillcolor="white" style="filled" fontcolor="black"]
node9 [label = "Arm A (n=143)" group=S6 fillcolor="white" style="filled" fontcolor="black"]
node10 [label = "Arm B (n=142)" group=S7 fillcolor="white" style="filled" fontcolor="black"]
node11 [label = "" group=S6 fillcolor="white" style="filled" fontcolor="black" shape=none height=0 width=0]
node12 [label = "From Arm B" group=S7 fillcolor="white" style="filled" fontcolor="black"]
node13 [label = "Combine all" group=S8 fillcolor="white" style="filled" fontcolor="black"]
node14 [label = "Process 1 (n=140)" group=S9 fillcolor="white" style="filled" fontcolor="black"]
node15 [label = "Process 2 (n=140)" group=S8 fillcolor="white" style="filled" fontcolor="black"]
node16 [label = "Process 3 (n=142)" group=S10 fillcolor="white" style="filled" fontcolor="black"]


## Invisible point node for joints

node [shape = point, width = 0, style=invis]

P1 [group=S1]
P2 [group=S2]
P3 [group=S3]
P4 [group=S4]
P5 [group=S5]
P6 [group=S3]
P7 [group=S6]
P8 [group=S3]
P9 [group=S7]
P10 [group=S6]
P11 [group=S8]
P12 [group=S7]
P13 [group=S9]
P14 [group=S8]
P15 [group=S10]

subgraph {
  rank = same; rankdir = LR; P1; P2; P3; P4; P5;
  }
subgraph {
  rank = same; rankdir = LR; node1; node2; node3; node4; node5;
  }
subgraph {
  rank = same; rankdir = LR; node6;
  }
subgraph {
  rank = same; rankdir = LR; P6; node7;
  }
subgraph {
  rank = same; rankdir = LR; P7; P8; P9;
  }
subgraph {
  rank = same; rankdir = LR; node9; node10;
  }
subgraph {
  rank = same; rankdir = LR; node11; node12;
  }
subgraph {
  rank = same; rankdir = LR; P10; P11; P12;
  }
subgraph {
  rank = same; rankdir = LR; P13; P14; P15;
  }
subgraph {
  rank = same; rankdir = LR; node14; node15; node16;
  }

edge[color="black" penwidth=1 style="" arrowhead="normal" arrowsize=1.00];

P3 -> node6;
node1 -> P1 [arrowhead = none];
node2 -> P2 [arrowhead = none];
node3 -> P3 [arrowhead = none];
node4 -> P4 [arrowhead = none];
node5 -> P5 [arrowhead = none];
P1 -> P2 -> P3 -> P4 -> P5 [arrowhead = none];
node6 -> P6 [arrowhead = none];
P6 -> node7;
P6 -> node8;
node8 -> P8 [arrowhead = none];
P7 -> node9;
P9 -> node10;
P7 -> P8 -> P9 [arrowhead = none];
node9 -> node11 [arrowhead = none];
node10 -> node12;
P11 -> node13;
node11 -> P10 [arrowhead = none];
node12 -> P12 [arrowhead = none];
P10 -> P11 -> P12 [arrowhead = none];
node13 -> P14 [arrowhead = none];
P13 -> node14;
P14 -> node15;
P15 -> node16;
P13 -> P14 -> P15 [arrowhead = none];


}
